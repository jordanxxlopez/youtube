  "cues": [
    {
      "kind": "dialogue",
      "scene_id": "scene-01",
      "line_id": "scene-01-line-01",
      "speaker": "TEO",
      "text": "One soft ball. Two hands. I can do this. Oh! That was almost a catch. Dani, can we try that again?",
      "start_seconds": 0.0,
      "end_seconds": 8.346,
      "duration_seconds": 8.346,
      "audio_path": "audio/lines/scene-01-line-01.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-01",
      "line_id": "scene-01-line-02",
      "speaker": "DANI",
      "text": "Absolutely. But first, I have a challenge. Can you discover how your brain and body work together to catch it?",
      "start_seconds": 8.346,
      "end_seconds": 16.862667,
      "duration_seconds": 8.516667,
      "audio_path": "audio/lines/scene-01-line-02.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-01",
      "line_id": "scene-01-line-03",
      "speaker": "TEO",
      "text": "My hands are right here. The rest of the team is a little harder to see.",
      "start_seconds": 16.862667,
      "end_seconds": 22.185333,
      "duration_seconds": 5.322667,
      "audio_path": "audio/lines/scene-01-line-03.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "action",
      "scene_id": "scene-01",
      "after_line_id": "scene-01-line-03",
      "start_seconds": 22.185333333333332,
      "end_seconds": 25.185333333333332,
      "duration_seconds": 3,
      "action": "The replay display pauses on the ball near Teo\u2019s hands; the title appears, followed by a wide reveal of the simulation.",
      "sound_direction": "Soft foam plop, a curious two-note musical phrase, then a quiet room hum."
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-01",
      "line_id": "scene-01-line-04",
      "speaker": "DANI",
      "text": "Welcome to our brain simulation. This whole room is a model we can explore. We are not inside a real person, and nobody has shrunk.",
      "start_seconds": 25.185333,
      "end_seconds": 36.057333,
      "duration_seconds": 10.872,
      "audio_path": "audio/lines/scene-01-line-04.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-01",
      "line_id": "scene-01-line-05",
      "speaker": "TEO",
      "text": "Good. My shoes already fit. Let's find the team before our next gentle toss.",
      "start_seconds": 36.057333,
      "end_seconds": 41.943333,
      "duration_seconds": 5.886,
      "audio_path": "audio/lines/scene-01-line-05.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-01",
      "line_id": "scene-01-line-06",
      "speaker": "DANI",
      "text": "We will visit four outer lobes of the cerebrum, the big, wrinkly part of the brain. Each side has these lobes. Other parts help, too.",
      "start_seconds": 41.943333,
      "end_seconds": 52.417292,
      "duration_seconds": 10.473958,
      "audio_path": "audio/lines/scene-01-line-06.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-01",
      "line_id": "scene-01-line-07",
      "speaker": "TEO",
      "text": "Come with me. You can help spot the clues. Watching is all you need to do.",
      "start_seconds": 52.417292,
      "end_seconds": 57.89925,
      "duration_seconds": 5.481958,
      "audio_path": "audio/lines/scene-01-line-07.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-02",
      "line_id": "scene-02-line-01",
      "speaker": "TEO",
      "text": "There is the ball in our replay. I noticed its color, and I saw it coming toward me.",
      "start_seconds": 57.89925,
      "end_seconds": 64.36125,
      "duration_seconds": 6.462,
      "audio_path": "audio/lines/scene-02-line-01.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-02",
      "line_id": "scene-02-line-02",
      "speaker": "DANI",
      "text": "Your eyes detect light. Information from your eyes reaches your brain. Areas in the occipital lobe, toward the back, help make sense of what you see.",
      "start_seconds": 64.36125,
      "end_seconds": 76.073917,
      "duration_seconds": 11.712667,
      "audio_path": "audio/lines/scene-02-line-02.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-02",
      "line_id": "scene-02-line-03",
      "speaker": "TEO",
      "text": "Occipital. That's a big name for a helpful teammate. I'll remember the back of our brain map.",
      "start_seconds": 76.073917,
      "end_seconds": 82.923917,
      "duration_seconds": 6.85,
      "audio_path": "audio/lines/scene-02-line-03.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-02",
      "line_id": "scene-02-line-04",
      "speaker": "DANI",
      "text": "Seeing involves other areas, too. This highlight means we are looking here on our tour. It does not mean the rest of the brain has switched off.",
      "start_seconds": 82.923917,
      "end_seconds": 93.140583,
      "duration_seconds": 10.216667,
      "audio_path": "audio/lines/scene-02-line-04.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "action",
      "scene_id": "scene-02",
      "after_line_id": "scene-02-line-04",
      "start_seconds": 93.14058333333334,
      "end_seconds": 96.14058333333334,
      "duration_seconds": 3,
      "action": "Hold the labeled brain map and replay together so the viewer can locate the back of the brain.",
      "sound_direction": "A soft marker chime; music lowers before the viewer question."
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-02",
      "line_id": "scene-02-line-05",
      "speaker": "TEO",
      "text": "Our first clue is seeing the ball. Which lobe did we just visit that helps with seeing?",
      "start_seconds": 96.140583,
      "end_seconds": 102.410583,
      "duration_seconds": 6.27,
      "audio_path": "audio/lines/scene-02-line-05.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "viewer_pause",
      "scene_id": "scene-02",
      "after_line_id": "scene-02-line-05",
      "question_id": "q1",
      "start_seconds": 102.41058333333334,
      "end_seconds": 105.41058333333334,
      "duration_seconds": 3.0
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-02",
      "line_id": "scene-02-line-06",
      "speaker": "DANI",
      "text": "The occipital lobe. If that name is new, you can point to the back of our map.",
      "start_seconds": 105.410583,
      "end_seconds": 111.34325,
      "duration_seconds": 5.932667,
      "audio_path": "audio/lines/scene-02-line-06.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-02",
      "line_id": "scene-02-line-07",
      "speaker": "TEO",
      "text": "Now I can see the ball. But I still need to work out where my hands should go.",
      "start_seconds": 111.34325,
      "end_seconds": 116.971917,
      "duration_seconds": 5.628667,
      "audio_path": "audio/lines/scene-02-line-07.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-03",
      "line_id": "scene-03-line-01",
      "speaker": "TEO",
      "text": "In the replay, my hands were a little too far apart. The ball found the gap. Very sneaky, ball.",
      "start_seconds": 116.971917,
      "end_seconds": 124.510583,
      "duration_seconds": 7.538667,
      "audio_path": "audio/lines/scene-03-line-01.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-03",
      "line_id": "scene-03-line-02",
      "speaker": "DANI",
      "text": "The parietal lobe helps process touch and information about where your body is. Working with other areas, it helps relate your hands to things around you.",
      "start_seconds": 124.510583,
      "end_seconds": 136.183208,
      "duration_seconds": 11.672625,
      "audio_path": "audio/lines/scene-03-line-02.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-03",
      "line_id": "scene-03-line-03",
      "speaker": "TEO",
      "text": "So the clue is not just ball over there. It is ball over there, hands over here, and a gap between them.",
      "start_seconds": 136.183208,
      "end_seconds": 143.797208,
      "duration_seconds": 7.614,
      "audio_path": "audio/lines/scene-03-line-03.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "action",
      "scene_id": "scene-03",
      "after_line_id": "scene-03-line-03",
      "start_seconds": 143.79720833333334,
      "end_seconds": 146.79720833333334,
      "duration_seconds": 3,
      "action": "The hand markers move closer together around the replayed ball; no live ball is thrown during this explanation.",
      "sound_direction": "Two soft positioning clicks; no success buzzer or alarm."
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-03",
      "line_id": "scene-03-line-04",
      "speaker": "DANI",
      "text": "Exactly. Your body also sends information back as you move. There is a lot of communication going on.",
      "start_seconds": 146.797208,
      "end_seconds": 154.627208,
      "duration_seconds": 7.83,
      "audio_path": "audio/lines/scene-03-line-04.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-03",
      "line_id": "scene-03-extra-01",
      "speaker": "TEO",
      "text": "Let's test our clue without throwing anything. Watch the two hands on the screen. First they're wide apart. Now they move closer together. The ball stays in the same place while the space around it changes.",
      "start_seconds": 154.627208,
      "end_seconds": 170.785167,
      "duration_seconds": 16.157958,
      "audio_path": "audio/lines/scene-03-extra-01.wav",
      "native_phoneme_timings_available": true,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "action",
      "scene_id": "scene-03",
      "after_line_id": "scene-03-extra-01",
      "start_seconds": 170.78516666666667,
      "end_seconds": 172.78516666666667,
      "duration_seconds": 2,
      "action": "A guided observation: keep the simulated ball fixed while the two illustrated hands move closer together. Hold the changed gap long enough to compare it with the previous position. This is a separate diagram demonstration, not another live toss.",
      "sound_direction": "Two quiet positioning clicks; no new speech or countdown."
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-03",
      "line_id": "scene-03-extra-02",
      "speaker": "DANI",
      "text": "That comparison matters. Your brain combines information about your body and the things nearby. It keeps updating as you move, instead of saving one picture and hoping nothing changes.",
      "start_seconds": 172.785167,
      "end_seconds": 187.312458,
      "duration_seconds": 14.527292,
      "audio_path": "audio/lines/scene-03-extra-02.wav",
      "native_phoneme_timings_available": true,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-03",
      "line_id": "scene-03-extra-03",
      "speaker": "TEO",
      "text": "Like keeping a map up to date. The ball has not moved, but the gap has.",
      "start_seconds": 187.312458,
      "end_seconds": 192.781792,
      "duration_seconds": 5.469333,
      "audio_path": "audio/lines/scene-03-extra-03.wav",
      "native_phoneme_timings_available": true,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-03",
      "line_id": "scene-03-line-05",
      "speaker": "TEO",
      "text": "Which lobe helps us work out where our hands are compared with the ball?",
      "start_seconds": 192.781792,
      "end_seconds": 197.517792,
      "duration_seconds": 4.736,
      "audio_path": "audio/lines/scene-03-line-05.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "viewer_pause",
      "scene_id": "scene-03",
      "after_line_id": "scene-03-line-05",
      "question_id": "q2",
      "start_seconds": 197.51779166666665,
      "end_seconds": 200.51779166666665,
      "duration_seconds": 3.0
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-03",
      "line_id": "scene-03-line-06",
      "speaker": "DANI",
      "text": "The parietal lobe, working with its teammates. You can find it toward the upper back of our map.",
      "start_seconds": 200.517792,
      "end_seconds": 207.227125,
      "duration_seconds": 6.709333,
      "audio_path": "audio/lines/scene-03-line-06.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-03",
      "line_id": "scene-03-line-07",
      "speaker": "TEO",
      "text": "I'm getting the picture. Seeing the ball and knowing where my hands are have to work together. No more giant gap.",
      "start_seconds": 207.227125,
      "end_seconds": 215.547125,
      "duration_seconds": 8.32,
      "audio_path": "audio/lines/scene-03-line-07.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-04",
      "line_id": "scene-04-line-01",
      "speaker": "DANI",
      "text": "Ready, Teo. Here comes the ball. That is the cue you heard before our first toss.",
      "start_seconds": 215.547125,
      "end_seconds": 221.59975,
      "duration_seconds": 6.052625,
      "audio_path": "audio/lines/scene-04-line-01.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-04",
      "line_id": "scene-04-line-02",
      "speaker": "TEO",
      "text": "I remember. That sound told me to pay attention. I was ready in my head. My hands were still working on it.",
      "start_seconds": 221.59975,
      "end_seconds": 229.845083,
      "duration_seconds": 8.245333,
      "audio_path": "audio/lines/scene-04-line-02.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-04",
      "line_id": "scene-04-line-03",
      "speaker": "DANI",
      "text": "Areas in the temporal lobe, at the side of the brain, help process sounds. Some parts here also help with memory. Other regions join in, too.",
      "start_seconds": 229.845083,
      "end_seconds": 241.265083,
      "duration_seconds": 11.42,
      "audio_path": "audio/lines/scene-04-line-03.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-04",
      "line_id": "scene-04-line-04",
      "speaker": "TEO",
      "text": "So my ears pick up sound, and my brain helps me make sense of it.",
      "start_seconds": 241.265083,
      "end_seconds": 246.129083,
      "duration_seconds": 4.864,
      "audio_path": "audio/lines/scene-04-line-04.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-04",
      "line_id": "scene-04-line-05",
      "speaker": "DANI",
      "text": "Yes. And you can catch a ball without hearing this cue. Different situations use different information.",
      "start_seconds": 246.129083,
      "end_seconds": 253.549708,
      "duration_seconds": 7.420625,
      "audio_path": "audio/lines/scene-04-line-05.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "action",
      "scene_id": "scene-04",
      "after_line_id": "scene-04-line-05",
      "start_seconds": 253.54970833333334,
      "end_seconds": 256.54970833333334,
      "duration_seconds": 3,
      "action": "Hold the intercom cue as text, with the temporal label and side-view map remaining visible.",
      "sound_direction": "Replay Dani\u2019s cue only as spoken in the first line; a restrained intercom click, without an extra unscripted voice."
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-04",
      "line_id": "scene-04-line-06",
      "speaker": "TEO",
      "text": "Which lobe on our map helps process the sound of Dani speaking?",
      "start_seconds": 256.549708,
      "end_seconds": 260.965708,
      "duration_seconds": 4.416,
      "audio_path": "audio/lines/scene-04-line-06.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "viewer_pause",
      "scene_id": "scene-04",
      "after_line_id": "scene-04-line-06",
      "question_id": "q3",
      "start_seconds": 260.96570833333334,
      "end_seconds": 263.96570833333334,
      "duration_seconds": 3.0
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-04",
      "line_id": "scene-04-line-07",
      "speaker": "DANI",
      "text": "The temporal lobe. Think of the side of our map. You can use the label while you learn the name.",
      "start_seconds": 263.965708,
      "end_seconds": 270.228375,
      "duration_seconds": 6.262667,
      "audio_path": "audio/lines/scene-04-line-07.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-04",
      "line_id": "scene-04-line-08",
      "speaker": "TEO",
      "text": "Clue collected. Now for the plan: how do I get my hands ready?",
      "start_seconds": 270.228375,
      "end_seconds": 274.969708,
      "duration_seconds": 4.741333,
      "audio_path": "audio/lines/scene-04-line-08.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-05",
      "line_id": "scene-05-line-01",
      "speaker": "TEO",
      "text": "My plan is to watch the ball and bring my hands together where it is going. No dramatic diving. This is a gentle toss.",
      "start_seconds": 274.969708,
      "end_seconds": 285.066333,
      "duration_seconds": 10.096625,
      "audio_path": "audio/lines/scene-05-line-01.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-05",
      "line_id": "scene-05-line-02",
      "speaker": "DANI",
      "text": "Areas in the frontal lobe help plan actions and control voluntary movements, the movements you choose to make.",
      "start_seconds": 285.066333,
      "end_seconds": 293.429667,
      "duration_seconds": 8.363333,
      "audio_path": "audio/lines/scene-05-line-02.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-05",
      "line_id": "scene-05-line-03",
      "speaker": "TEO",
      "text": "Like choosing to reach for the ball instead of letting it visit the floor again.",
      "start_seconds": 293.429667,
      "end_seconds": 298.784333,
      "duration_seconds": 5.354667,
      "audio_path": "audio/lines/scene-05-line-03.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-05",
      "line_id": "scene-05-line-04",
      "speaker": "DANI",
      "text": "Right. The frontal lobe works with many other areas. There is no tiny person in your brain giving every order.",
      "start_seconds": 298.784333,
      "end_seconds": 306.989667,
      "duration_seconds": 8.205333,
      "audio_path": "audio/lines/scene-05-line-04.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "action",
      "scene_id": "scene-05",
      "after_line_id": "scene-05-line-04",
      "start_seconds": 306.98966666666666,
      "end_seconds": 309.98966666666666,
      "duration_seconds": 3,
      "action": "Hold a plan card showing an open, comfortable hand position beside the ball\u2019s short, gentle arc.",
      "sound_direction": "A small pencil-like sketch sound; warm music continues quietly."
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-05",
      "line_id": "scene-05-line-05",
      "speaker": "TEO",
      "text": "Which lobe at the front helps plan actions and control the movements we choose?",
      "start_seconds": 309.989667,
      "end_seconds": 315.600333,
      "duration_seconds": 5.610667,
      "audio_path": "audio/lines/scene-05-line-05.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "viewer_pause",
      "scene_id": "scene-05",
      "after_line_id": "scene-05-line-05",
      "question_id": "q4",
      "start_seconds": 315.6003333333333,
      "end_seconds": 318.6003333333333,
      "duration_seconds": 3.0
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-05",
      "line_id": "scene-05-line-06",
      "speaker": "DANI",
      "text": "The frontal lobe. If you pointed to the front of our map, you found it.",
      "start_seconds": 318.600333,
      "end_seconds": 323.211667,
      "duration_seconds": 4.611333,
      "audio_path": "audio/lines/scene-05-line-06.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-05",
      "line_id": "scene-05-line-07",
      "speaker": "TEO",
      "text": "Four lobes, four stops on our tour. But our brain does not wait for a tour guide to finish talking before it works.",
      "start_seconds": 323.211667,
      "end_seconds": 332.003,
      "duration_seconds": 8.791333,
      "audio_path": "audio/lines/scene-05-line-07.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-05",
      "line_id": "scene-05-line-08",
      "speaker": "DANI",
      "text": "Thankfully. These regions communicate and cooperate. Our visits are not a list of steps every signal must follow.",
      "start_seconds": 332.003,
      "end_seconds": 341.017667,
      "duration_seconds": 9.014667,
      "audio_path": "audio/lines/scene-05-line-08.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-line-01",
      "speaker": "TEO",
      "text": "Wait. There is another part tucked underneath at the back. We haven't met everybody.",
      "start_seconds": 341.017667,
      "end_seconds": 346.787,
      "duration_seconds": 5.769333,
      "audio_path": "audio/lines/scene-06-line-01.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-line-02",
      "speaker": "DANI",
      "text": "That is the cerebellum. It helps coordinate movements and their timing. It also helps us learn from practice.",
      "start_seconds": 346.787,
      "end_seconds": 355.171667,
      "duration_seconds": 8.384667,
      "audio_path": "audio/lines/scene-06-line-02.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-line-03",
      "speaker": "TEO",
      "text": "That sounds useful for getting both hands to the same appointment with the ball.",
      "start_seconds": 355.171667,
      "end_seconds": 360.611667,
      "duration_seconds": 5.44,
      "audio_path": "audio/lines/scene-06-line-03.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-line-04",
      "speaker": "DANI",
      "text": "Very useful. Movement signals travel through the spinal cord and nerves to muscles in your arms and hands. Your muscles pull to move your body.",
      "start_seconds": 360.611667,
      "end_seconds": 371.900292,
      "duration_seconds": 11.288625,
      "audio_path": "audio/lines/scene-06-line-04.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "action",
      "scene_id": "scene-06",
      "after_line_id": "scene-06-line-04",
      "start_seconds": 371.90029166666665,
      "end_seconds": 374.90029166666665,
      "duration_seconds": 3,
      "action": "Trace one simplified movement route to the arm and one feedback route returning from the body; keep both labels readable.",
      "sound_direction": "A quiet traveling tone in each direction, without a racing or emergency effect."
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-line-05",
      "speaker": "TEO",
      "text": "And information from my body travels back, too. This team keeps in touch.",
      "start_seconds": 374.900292,
      "end_seconds": 380.562958,
      "duration_seconds": 5.662667,
      "audio_path": "audio/lines/scene-06-line-05.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-line-06",
      "speaker": "DANI",
      "text": "Yes. The brain and body work together. The cerebellum is part of that team, not a guarantee that every catch will work.",
      "start_seconds": 380.562958,
      "end_seconds": 389.780292,
      "duration_seconds": 9.217333,
      "audio_path": "audio/lines/scene-06-line-06.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-extra-01",
      "speaker": "TEO",
      "text": "Let's follow both directions on our diagram. The gold path shows movement signals going toward the arm. The green path shows information coming back.",
      "start_seconds": 389.780292,
      "end_seconds": 402.34625,
      "duration_seconds": 12.565958,
      "audio_path": "audio/lines/scene-06-extra-01.wav",
      "native_phoneme_timings_available": true,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "action",
      "scene_id": "scene-06",
      "after_line_id": "scene-06-extra-01",
      "start_seconds": 402.34625,
      "end_seconds": 404.34625,
      "duration_seconds": 2,
      "action": "A guided observation: keep the gold movement-signal route and green returning-information route visible together. Let a marker move along each at the same time, then hold both labels for comparison.",
      "sound_direction": "A quiet pair of traveling tones under the visual comparison; no new speech."
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-extra-02",
      "speaker": "DANI",
      "text": "That return information helps the nervous system keep track of what is happening. These lines are teaching symbols, not two glowing strings inside you. Real nerves contain many fibers carrying signals.",
      "start_seconds": 404.34625,
      "end_seconds": 420.453583,
      "duration_seconds": 16.107333,
      "audio_path": "audio/lines/scene-06-extra-02.wav",
      "native_phoneme_timings_available": true,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-extra-03",
      "speaker": "TEO",
      "text": "So catching is not just sending one command and walking away. The team keeps checking in.",
      "start_seconds": 420.453583,
      "end_seconds": 427.432875,
      "duration_seconds": 6.979292,
      "audio_path": "audio/lines/scene-06-extra-03.wav",
      "native_phoneme_timings_available": true,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-extra-04",
      "speaker": "DANI",
      "text": "Exactly. Practice gives that team more chances to learn how a movement went.",
      "start_seconds": 427.432875,
      "end_seconds": 433.0595,
      "duration_seconds": 5.626625,
      "audio_path": "audio/lines/scene-06-extra-04.wav",
      "native_phoneme_timings_available": true,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-line-07",
      "speaker": "TEO",
      "text": "Which part we just met helps coordinate movements and their timing?",
      "start_seconds": 433.0595,
      "end_seconds": 437.582167,
      "duration_seconds": 4.522667,
      "audio_path": "audio/lines/scene-06-line-07.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "viewer_pause",
      "scene_id": "scene-06",
      "after_line_id": "scene-06-line-07",
      "question_id": "q5",
      "start_seconds": 437.5821666666667,
      "end_seconds": 440.5821666666667,
      "duration_seconds": 3.0
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-line-08",
      "speaker": "DANI",
      "text": "The cerebellum. It is the smaller, folded part at the lower back of our brain model.",
      "start_seconds": 440.582167,
      "end_seconds": 446.762167,
      "duration_seconds": 6.18,
      "audio_path": "audio/lines/scene-06-line-08.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-06",
      "line_id": "scene-06-line-09",
      "speaker": "TEO",
      "text": "Missing one catch does not mean the team is broken. We can learn with practice.",
      "start_seconds": 446.762167,
      "end_seconds": 452.780167,
      "duration_seconds": 6.018,
      "audio_path": "audio/lines/scene-06-line-09.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-07",
      "line_id": "scene-07-line-01",
      "speaker": "TEO",
      "text": "Our map is getting busy. Who's waving from that little screen?",
      "start_seconds": 452.780167,
      "end_seconds": 457.236833,
      "duration_seconds": 4.456667,
      "audio_path": "audio/lines/scene-07-line-01.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-07",
      "line_id": "scene-07-line-02",
      "speaker": "DANI",
      "text": "Three guide programs, based on real kinds of brain cells. Real cells do not talk. We have enlarged these models so we can meet them.",
      "start_seconds": 457.236833,
      "end_seconds": 467.7435,
      "duration_seconds": 10.506667,
      "audio_path": "audio/lines/scene-07-line-02.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-07",
      "line_id": "scene-07-line-03",
      "speaker": "NEURON_GUIDE",
      "text": "I represent a neuron. Neurons send messages using electrical and chemical signals. Lots of us connect into networks.",
      "start_seconds": 467.7435,
      "end_seconds": 476.744167,
      "duration_seconds": 9.000667,
      "audio_path": "audio/lines/scene-07-line-03.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_bella",
      "speed": 0.84
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-07",
      "line_id": "scene-07-line-04",
      "speaker": "TEO",
      "text": "A whole team of tiny message senders. Now the connections on our map make sense.",
      "start_seconds": 476.744167,
      "end_seconds": 483.082167,
      "duration_seconds": 6.338,
      "audio_path": "audio/lines/scene-07-line-04.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-07",
      "line_id": "scene-07-line-05",
      "speaker": "ASTROCYTE_GUIDE",
      "text": "I represent an astrocyte. Astrocytes support neurons and help keep conditions around them working well.",
      "start_seconds": 483.082167,
      "end_seconds": 495.562833,
      "duration_seconds": 12.480667,
      "audio_path": "audio/lines/scene-07-line-05.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_nicole",
      "speed": 0.82
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-07",
      "line_id": "scene-07-line-06",
      "speaker": "MICROGLIA_GUIDE",
      "text": "I represent a microglial cell. Microglia are immune cells. We help watch for trouble and clear away damaged material.",
      "start_seconds": 495.562833,
      "end_seconds": 506.34675,
      "duration_seconds": 10.783917,
      "audio_path": "audio/lines/scene-07-line-06.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_fenrir",
      "speed": 0.8
    },
    {
      "kind": "action",
      "scene_id": "scene-07",
      "after_line_id": "scene-07-line-06",
      "start_seconds": 506.34675,
      "end_seconds": 509.34675,
      "duration_seconds": 3,
      "action": "Hold all three labeled cell models together, then let the small debris inset complete its clearly schematic action.",
      "sound_direction": "Three gentle, distinct character entrance notes; the debris inset has no crunch or gross sound."
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-07",
      "line_id": "scene-07-line-07",
      "speaker": "TEO",
      "text": "So you do not rush in and fix a missed catch.",
      "start_seconds": 509.34675,
      "end_seconds": 512.28675,
      "duration_seconds": 2.94,
      "audio_path": "audio/lines/scene-07-line-07.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-07",
      "line_id": "scene-07-line-08",
      "speaker": "MICROGLIA_GUIDE",
      "text": "No. Clearing cellular debris is a different job. Your practice catch belongs to the movement team.",
      "start_seconds": 512.28675,
      "end_seconds": 520.339417,
      "duration_seconds": 8.052667,
      "audio_path": "audio/lines/scene-07-line-08.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_fenrir",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-07",
      "line_id": "scene-07-line-09",
      "speaker": "DANI",
      "text": "These are just three kinds of cells. There are many more teammates to discover.",
      "start_seconds": 520.339417,
      "end_seconds": 525.528083,
      "duration_seconds": 5.188667,
      "audio_path": "audio/lines/scene-07-line-09.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-08",
      "line_id": "scene-08-line-01",
      "speaker": "TEO",
      "text": "I'm ready for another gentle try. Ball, please keep your appointment with my hands.",
      "start_seconds": 525.528083,
      "end_seconds": 531.994083,
      "duration_seconds": 6.466,
      "audio_path": "audio/lines/scene-08-line-01.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-08",
      "line_id": "scene-08-line-02",
      "speaker": "DANI",
      "text": "Here it comes.",
      "start_seconds": 531.994083,
      "end_seconds": 533.38075,
      "duration_seconds": 1.386667,
      "audio_path": "audio/lines/scene-08-line-02.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "action",
      "scene_id": "scene-08",
      "after_line_id": "scene-08-line-02",
      "start_seconds": 533.38075,
      "end_seconds": 536.38075,
      "duration_seconds": 3,
      "action": "Play the gentle catch once in full; keep the team inset active in overlapping patterns. Do not make success depend on every region lighting up in a fixed order.",
      "sound_direction": "A soft catch sound, a small warm musical lift, then room for the recap."
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-08",
      "line_id": "scene-08-line-03",
      "speaker": "DANI",
      "text": "Nice catch, Teo. And if it had fallen, we could simply try again.",
      "start_seconds": 536.38075,
      "end_seconds": 541.581417,
      "duration_seconds": 5.200667,
      "audio_path": "audio/lines/scene-08-line-03.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-08",
      "line_id": "scene-08-line-04",
      "speaker": "TEO",
      "text": "We saw the ball, worked out where it was, planned a movement, and coordinated our hands. My nerves and muscles helped make it happen.",
      "start_seconds": 541.581417,
      "end_seconds": 551.849333,
      "duration_seconds": 10.267917,
      "audio_path": "audio/lines/scene-08-line-04.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-08",
      "line_id": "scene-08-line-05",
      "speaker": "DANI",
      "text": "And you heard my cue. Different brain regions and your body were working together, with information moving between them.",
      "start_seconds": 551.849333,
      "end_seconds": 560.364625,
      "duration_seconds": 8.515292,
      "audio_path": "audio/lines/scene-08-line-05.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-08",
      "line_id": "scene-08-line-06",
      "speaker": "TEO",
      "text": "Did one part make that catch happen, or did lots of parts work together?",
      "start_seconds": 560.364625,
      "end_seconds": 565.911292,
      "duration_seconds": 5.546667,
      "audio_path": "audio/lines/scene-08-line-06.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "viewer_pause",
      "scene_id": "scene-08",
      "after_line_id": "scene-08-line-06",
      "question_id": "q6",
      "start_seconds": 565.9112916666667,
      "end_seconds": 568.9112916666667,
      "duration_seconds": 3.0
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-08",
      "line_id": "scene-08-line-07",
      "speaker": "DANI",
      "text": "Lots of parts, working together. That is our brain team challenge solved.",
      "start_seconds": 568.911292,
      "end_seconds": 574.297958,
      "duration_seconds": 5.386667,
      "audio_path": "audio/lines/scene-08-line-07.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "af_heart",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-08",
      "line_id": "scene-08-line-08",
      "speaker": "TEO",
      "text": "One catch. A whole team. You can keep being a brain detective just by watching everyday actions.",
      "start_seconds": 574.297958,
      "end_seconds": 581.721958,
      "duration_seconds": 7.424,
      "audio_path": "audio/lines/scene-08-line-08.wav",
      "native_phoneme_timings_available": false,
      "voice_id": "am_puck",
      "speed": 0.8
    },
    {
      "kind": "dialogue",
      "scene_id": "scene-08",
      "line_id": "scene-08-line-09",
      "speaker": "DANI",
      "text": "If you try a gentle soft-ball catch later, ask a trusted grown-up and choose a clear space. Watching is fine, too.",
      "start_seconds": 581.721958,
      "end_seconds": 591.117958,
      "duration_seconds": 9.396,
